---
import BlogIndex from "../../../components/BlogIndex.astro";
import { localeList } from "../../../i18n/utils";
import { defaultLang } from "../../../i18n/ui";

export function getStaticPaths() {
  return localeList
    .filter((l) => l !== defaultLang)
    .map((l) => ({ params: { lang: l } }));
}
