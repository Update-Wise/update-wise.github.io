---
import { getLang, useTranslations, getDownloadPath } from "../i18n/utils";
import Mascot from "./Mascot.astro";

const lang = getLang(Astro.url);
const t = useTranslations(lang);

const chips = [
  { key: "download.windows", class: "chip-win" },
  { key: "download.linux", class: "chip-linux" },
  { key: "download.macos", class: "chip-mac" },
] as const;

const stats = ["hero.stat1", "hero.stat2", "hero.stat3"] as const;
---

<header class="hero">
  <div class="orb orb-a" aria-hidden="true"></div>
  <div class="orb orb-b" aria-hidden="true"></div>

  <div class="hero-content">
    <h1 class="Hero_text" id="title" data-enter style="--enter-delay: 90ms">
      <span>{t("hero.title1")}</span>
      <span id="span2">{t("hero.title2")}</span>
    </h1>
    <p class="description" data-enter style="--enter-delay: 180ms">
      {t("hero.subtitle")}
    </p>
    <div class="ctacontainer" data-enter style="--enter-delay: 270ms">
      <a class="cta" id="cta1" href={getDownloadPath(lang)}>
        <span>{t("hero.cta1")}</span>
      </a>
      <a class="cta" id="cta2" href="#how-it-works">
        <span>{t("hero.cta2")}</span>
      </a>
    </div>
    <p class="hero-note" data-enter style="--enter-delay: 340ms">
      {t("hero.note")}
    </p>
    <dl class="hero-stats" data-enter style="--enter-delay: 420ms">
      {stats.map((key) => (
        <div class="stat">
          <dt class="stat-value" data-count>
            {t(key)}
          </dt>
        </div>
      ))}
    </dl>
  </div>
  <div class="hero-image-wrapper" data-enter style="--enter-delay: 200ms">
    <div class="shot-frame">
      <img
        alt={t("seo.ogAlt")}
        src="/images/landing/app-mock.jpg"
        loading="lazy"
        decoding="async"
      />
      {chips.map((chip) => (
        <span class={`shot-chip ${chip.class}`} aria-hidden="true">
          ✓ {t(chip.key)}
        </span>
      ))}
      <Mascot />
    </div>
  </div>
</header>

<style>
  .hero {
    position: relative;
    display: flex;
    min-height: calc(100dvh - 7.5rem);
    align-items: center;
    overflow: clip;
    isolation: isolate;
  }

  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -2;
    background: var(--gradient-hero-wash);
  }

  .orb {
    position: absolute;
    z-index: -1;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.55;
    pointer-events: none;
  }

  .orb-a {
    width: 26rem;
    height: 26rem;
    top: -8rem;
    right: -6rem;
    background: var(--color-glow);
  }

  .orb-b {
    width: 20rem;
    height: 20rem;
    bottom: -10rem;
    left: -6rem;
    background: var(--color-glow);
    opacity: 0.35;
  }

  html.js-anim .orb-a {
    animation: drift 9s var(--ease-out) infinite alternate;
  }

  html.js-anim .orb-b {
    animation: drift 12s var(--ease-out) infinite alternate;
  }

  @keyframes drift {
    from {
      transform: translate3d(0, 0, 0) scale(1);
    }
    to {
      transform: translate3d(-2.5rem, 2rem, 0) scale(1.12);
    }
  }

  .hero-content,
  .hero-image-wrapper {
    flex: 1;
    padding: 1rem;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    padding: 4rem;
  }

  html.js-anim .hero [data-enter] {
    opacity: 0;
    animation: enter var(--dur-med) var(--ease-out) forwards;
    animation-delay: var(--enter-delay, 0ms);
  }

  @keyframes enter {
    from {
      opacity: 0;
      transform: translateY(1.4rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .badge-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-success);
  }

  html.js-anim .badge-dot {
    animation: pulse 2.2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 var(--color-glow-strong);
    }
    50% {
      box-shadow: 0 0 0 0.45rem transparent;
    }
  }

  #title {
    span {
      display: block;
    }

    #span2 {
      background: var(--gradient-brand);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    font-size: clamp(2rem, 4.5vw, 3.25rem);
    line-height: 1.05;
    margin: 0;
  }

  .hero-note {
    margin: 1rem 0 0;
    font-size: 0.7rem;
    color: var(--color-text-secondary);
  }

  .hero-stats {
    display: flex;
    gap: 2rem;
    margin: 2rem 0 0;
    padding: 0;
  }

  .stat-value {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--color-text-primary);
  }

  .hero-image-wrapper {
    display: flex;
    place-content: end;
    row-gap: 1rem;
  }

  .shot-frame {
    position: relative;
    width: 100%;
  }

  .shot-frame img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 0.75rem;
    border: 1px solid var(--color-surface-outline);
    box-shadow:
      0 24px 60px -12px var(--color-glow-strong),
      -12px 12px 4px 0 #0000006f;
  }

  .shot-chip {
    position: absolute;
    padding: 0.4rem 0.8rem;
    font-size: 0.65rem;
    font-weight: 500;
    white-space: nowrap;
    color: var(--color-text-primary);
    background: var(--color-glass);
    border: 1px solid var(--color-surface-outline);
    border-radius: 999px;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 8px 24px -8px var(--color-glow-strong);
  }

  .chip-win {
    top: 8%;
    left: -1.5rem;
  }

  .chip-linux {
    top: 44%;
    right: -1rem;
  }

  .chip-mac {
    bottom: 10%;
    left: 12%;
  }

  html.js-anim .shot-chip {
    animation: floaty 5s ease-in-out infinite;
  }

  html.js-anim .chip-linux {
    animation-delay: -1.6s;
  }

  html.js-anim .chip-mac {
    animation-delay: -3.2s;
  }

  @keyframes floaty {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-0.6rem);
    }
  }

  .ctacontainer {
    display: flex;
    margin-top: 3rem;
    gap: 1rem;
  }

  .cta {
    position: relative;
    overflow: hidden;
    cursor: pointer;
    display: flex;
    width: 200px;
    height: 50px;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 4px 0 #0000006f;
    border-radius: 0.75rem;
    transition:
      transform 0.1s ease-in-out,
      box-shadow var(--dur-fast) var(--ease-out);
    span {
      -webkit-user-select: none;
      -moz-user-select: none;
      -ms-user-select: none;
      user-select: none;
      font-size: 0.75rem;
      font-weight: 200;
      pointer-events: min-content;
    }
  }

  #cta1 {
    background-color: var(--color-primary-darkened);

    span {
      color: var(--color-text-lighter);
    }
  }

  #cta1::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    width: 40%;
    left: -60%;
    background: linear-gradient(
      100deg,
      transparent,
      rgb(255 255 255 / 35%),
      transparent
    );
    transform: skewX(-20deg);
  }

  html.js-anim #cta1:hover::after {
    animation: sheen 0.7s var(--ease-out);
  }

  @keyframes sheen {
    to {
      left: 130%;
    }
  }

  #cta2 {
    outline: 1px var(--neutral-100);

    backdrop-filter: blur(24px) saturate(150%);

    -webkit-backdrop-filter: blur(24px) saturate(150%);

    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 20%),
      inset 0 -1px 0 rgb(0 0 0 / 20%),
      0 4px 4px 0 #0000006f;

    span {
      text-decoration: none;
    }
  }

  .cta:hover {
    transform: translateY(-2px);
  }

  #cta1:hover {
    box-shadow:
      0 8px 24px -6px var(--color-glow-strong),
      0 4px 4px 0 #0000006f;
  }

  .cta:active {
    transform: translateY(1px);
  }

  @media (max-width: 900px) {
    .hero-content {
      align-items: center;
      text-align: center;
      padding: 0;
      p {
        justify-content: center;
      }
    }
    .hero-badge {
      margin-inline: auto;
    }
    .hero-stats {
      justify-content: center;
      gap: 1.5rem;
    }
    .hero {
      flex-direction: column;
    }

    .shot-frame {
      max-width: 25rem;
      margin-inline: auto;
    }

    .chip-win {
      left: 0.5rem;
    }

    .chip-linux {
      right: 0.5rem;
    }
  }
</style>
