---
import Layout from "../layouts/Layout.astro";
import { getLang, useTranslations } from "../i18n/utils";

const t = useTranslations(getLang(Astro.url));

// Placeholder release URLs until real binaries are published.
// Replace with the final GitHub Releases (or CDN) links.
const releases = {
  windows: "https://github.com/Update-Wise/Update-Wise-Main/releases/latest",
  linux: "https://github.com/Update-Wise/Update-Wise-Main/releases/latest",
  macos: "https://github.com/Update-Wise/Update-Wise-Main/releases/latest",
} as const;
---

<Layout
  title={t("download.title")}
  description={t("download.subtitle")}
  slug="download"
>
  <main class="download-page">
    <header class="section-header">
      <p class="eyebrow">{t("download.eyebrow")}</p>
      <h1>{t("download.title")}</h1>
      <p class="subtitle">{t("download.subtitle")}</p>
    </header>

    <section id="download-recommended" aria-live="polite" hidden>
      <p class="detected-label">
        {t("download.detected")} <strong id="download-os-name"></strong>
      </p>
      <article
        class="download-card download-card--featured"
        id="download-featured-card"
      >
        <div>
          <h2 id="download-featured-title"></h2>
          <p id="download-featured-desc" class="muted"></p>
          <p class="version">{t("download.version")}</p>
        </div>
        <a
          id="download-featured-link"
          class="download-button"
          href={releases.windows}
        >
          {t("download.cta")}
        </a>
      </article>
      <p id="download-unknown" class="muted" hidden>
        {t("download.unknown")}
      </p>
    </section>

    <section aria-label={t("download.other")}>
      <h2 class="other-title">{t("download.other")}</h2>
      <div class="download-grid">
        <article class="download-card" data-os="windows">
          <h3>{t("download.windows")}</h3>
          <p class="muted">{t("download.windowsDesc")}</p>
          <p class="version">{t("download.version")}</p>
          <a
            class="download-button"
            href={releases.windows}
            data-os-link="windows"
          >
            {t("download.cta")} · {t("download.windows")}
          </a>
          <p class="soon">{t("download.soon")}</p>
        </article>
        <article class="download-card" data-os="linux">
          <h3>{t("download.linux")}</h3>
          <p class="muted">{t("download.linuxDesc")}</p>
          <p class="version">{t("download.version")}</p>
          <a class="download-button" href={releases.linux} data-os-link="linux">
            {t("download.cta")} · {t("download.linux")}
          </a>
          <p class="soon">{t("download.soon")}</p>
        </article>
        <article class="download-card" data-os="macos">
          <h3>{t("download.macos")}</h3>
          <p class="muted">{t("download.macosDesc")}</p>
          <p class="version">{t("download.version")}</p>
          <a class="download-button" href={releases.macos} data-os-link="macos">
            {t("download.cta")} · {t("download.macos")}
          </a>
          <p class="soon">{t("download.soon")}</p>
        </article>
      </div>
      <p class="note">{t("download.note")}</p>
    </section>
  </main>
</Layout>

<script define:vars={{ releases }}>
  const section = document.querySelector("#download-recommended");
  const osName = document.querySelector("#download-os-name");
  const title = document.querySelector("#download-featured-title");
  const desc = document.querySelector("#download-featured-desc");
  const link = document.querySelector("#download-featured-link");
  const unknown = document.querySelector("#download-unknown");

  const detectOS = () => {
    const platform = (
      navigator.userAgentData?.platform ??
      navigator.platform ??
      navigator.userAgent ??
      ""
    ).toLowerCase();
    if (platform.includes("win")) return "windows";
    if (platform.includes("mac") || platform.includes("darwin")) return "macos";
    if (
      platform.includes("linux") ||
      platform.includes("android") ||
      platform.includes("x11")
    )
      return "linux";
    return null;
  };

  const os = detectOS();
  if (section instanceof HTMLElement) section.hidden = false;

  if (!os) {
    if (unknown instanceof HTMLElement) unknown.hidden = false;
  } else {
    const card = document.querySelector(`[data-os="${os}"]`);
    const cardTitle = card?.querySelector("h3")?.textContent ?? os;
    const cardDesc = card?.querySelector("[class='muted']")?.textContent ?? "";
    if (osName) osName.textContent = cardTitle;
    if (title) title.textContent = cardTitle;
    if (desc) desc.textContent = cardDesc;
    if (link instanceof HTMLAnchorElement) {
      link.href = releases[os];
      link.textContent = link.textContent;
    }
    card?.setAttribute("data-recommended", "true");
  }
</script>

<style>
  .download-page {
    width: min(calc(100% - 2rem), 60rem);
    margin-inline: auto;
    padding: 7rem 0 5rem;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }
  .section-header {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .section-header h1 {
    margin: 0;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 500;
  }
  .subtitle {
    max-width: 40rem;
    color: var(--color-text-secondary);
    font-size: 0.85rem;
    line-height: 1.6;
  }
  .detected-label {
    font-size: 0.85rem;
  }
  .download-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }
  .other-title {
    font-size: 1.1rem;
    font-weight: 500;
  }
  .download-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-surface-secondary);
    border-radius: 1.25rem;
  }
  .download-card--featured {
    border: 1.5px solid var(--color-primary);
  }
  .download-card h2,
  .download-card h3 {
    margin: 0;
    font-size: 1rem;
  }
  .muted {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.75rem;
    line-height: 1.5;
  }
  .version {
    margin: 0;
    font-size: 0.7rem;
    opacity: 0.8;
  }
  .download-button {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 2.4rem;
    margin-top: auto;
    border-radius: 0.6rem;
    background-color: var(--color-primary);
    color: var(--color-text-lighter);
    text-decoration: none;
    font-size: 0.8rem;
  }
  .soon {
    margin: 0;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    opacity: 0.7;
  }
  .note {
    margin-top: 1.5rem;
    color: var(--color-text-secondary);
    font-size: 0.7rem;
    line-height: 1.6;
  }
  [data-recommended="true"] {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
  @media (max-width: 900px) {
    .download-grid {
      grid-template-columns: 1fr;
      max-width: 30rem;
      margin-inline: auto;
      width: 100%;
    }
  }
</style>
