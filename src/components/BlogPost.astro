---
import { render } from "astro:content";
import MarkdownLayout from "../layouts/MarkdownLayout.astro";
import type { CollectionEntry } from "astro:content";
import { getLang, useTranslations, getBlogPath } from "../i18n/utils";

interface Props {
  entry: CollectionEntry<"blog">;
}

const lang = getLang(Astro.url);
const t = useTranslations(lang);
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
// Entry id "es/blog/2026/welcome" -> hreflang slug "blog/2026/welcome"
const slug = `blog/${entry.id.split("/").slice(2).join("/")}`;
---

<MarkdownLayout
  title={entry.data.title}
  description={entry.data.description}
  updatedAt={entry.data.pubDate}
  updatedLabel={t("blog.published")}
  backHref={getBlogPath(lang)}
  backLabel={t("blog.back")}
  slug={slug}
  headings={headings}
>
  <Content />
</MarkdownLayout>
