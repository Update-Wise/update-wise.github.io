---
import Hardware from "../assets/hardwareico.svg";
import Analytics from "../assets/analytivsico.svg";
import { getLang, useTranslations } from "../i18n/utils";

const t = useTranslations(getLang(Astro.url));

const capabilities = [
  { icon: "hardware", titleKey: "features.detect.title", descKey: "features.detect.desc" },
  { icon: "analytics", titleKey: "features.recs.title", descKey: "features.recs.desc" },
  { icon: "check", titleKey: "features.easy.title", descKey: "features.easy.desc" },
] as const;
---

<section id="key-capabilities">
  <header class="section-header">
    <p class="eyebrow">{t("features.eyebrow")}</p>

    <h2>{t("features.title")}</h2>
  </header>

  <ul class="capabilities">
    {
      capabilities.map((cap) => (
        <li class="capability-card">
          <span class="capability-icon" aria-hidden="true">
            {cap.icon === "hardware" ? (
              <Hardware />
            ) : cap.icon === "analytics" ? (
              <Analytics />
            ) : (
              "✓"
            )}
          </span>

          <div class="capability-content">
            <h3>{t(cap.titleKey)}</h3>

            <p class="description">{t(cap.descKey)}</p>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  #key-capabilities {
    display: flex;
    flex-direction: column;
    align-items: center;

    width: 100%;
    padding: 5rem 1rem;
  }

  .section-header {
    display: flex;
    flex-direction: column;
    align-items: center;

    width: min(100%, 60rem);

    text-align: center;
  }

  .section-header h2 {
    margin: 0;

    color: var(--color-text-primary);

    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 400;
    line-height: 1.2;
  }

  .capabilities {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;

    width: min(calc(100% - 2rem), 60rem);

    padding: 0;
    margin: 2rem 0 0;

    list-style: none;
  }

  .capability-card {
    display: flex;
    flex-direction: column;

    min-width: 0;
    min-height: 9rem;

    padding: 1rem;

    background-color: var(--color-surface);

    border: 1px solid var(--color-surface-secondary);
    border-radius: 1.5rem;

    box-shadow: 0 2px 8px rgb(15 26 36 / 4%);
  }

  .capability-icon {
    display: grid;
    place-items: center;

    width: 2.25rem;
    height: 2.25rem;

    flex-shrink: 0;

    margin-bottom: 0.75rem;

    background-color: var(--color-primary);

    border-radius: 50%;

    color: var(--color-text-ligther);

    font-size: 1rem;
    font-weight: 500;
  }

  .capability-content {
    display: flex;
    flex-direction: column;

    min-width: 0;
  }

  .capability-content h3 {
    margin: 0 0 0.75rem;

    color: var(--color-text-primary);

    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.2;
  }

  .capability-content .description {
    margin: 0;

    color: var(--color-text-secondary);

    font-size: 0.7rem;
    font-weight: 300;
    line-height: 1.45;
  }

  @media (max-width: 900px) {
    .capabilities {
      grid-template-columns: 1fr;
      width: min(calc(100% - 2rem), 30rem);
    }
  }
</style>
