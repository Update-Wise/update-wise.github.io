---
import Rise from "./rise.astro"
---

<div class="mascot" aria-hidden="true" data-mascot>
  <div class="mascot-tilt" data-mascot-tilt>
    <div class="mascot-sprite" data-mascot-sprite>
      <Rise class="mascot-image" alt="rise el gato" />
    </div>
  </div>
  <div class="mascot-shadow" data-mascot-shadow></div>
</div>

<script>
  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  const mascot = document.querySelector<HTMLElement>("[data-mascot]");
  const tilt = document.querySelector<HTMLElement>("[data-mascot-tilt]");

  const pupils = [
    ...document.querySelectorAll<HTMLElement>("[data-mascot-pupil]"),
  ];

  const eyes = [
    ...document.querySelectorAll<HTMLElement>("[data-mascot-eye]"),
  ];

  const smile = document.querySelector<HTMLElement>("[data-mascot-smile]");

  const cheeks = [
    ...document.querySelectorAll<HTMLElement>("[data-mascot-cheek]"),
  ];

  const shadow = document.querySelector<HTMLElement>("[data-mascot-shadow]");

  const lightning = mascot?.querySelector<SVGElement>("#rise-lightning");

  const lightningShapes = lightning
    ? [
        ...lightning.querySelectorAll<SVGElement>(
          "path, polygon, polyline, rect, circle, ellipse",
        ),
      ]
    : [];

  if (
    !reduceMotion &&
    mascot instanceof HTMLElement &&
    tilt instanceof HTMLElement
  ) {
    const state = {
      px: 0,
      py: 0,
      rx: 0,
      ry: 0,
      tpx: 0,
      tpy: 0,
      trx: 0,
      try_: 0,
      squash: 0,
      happy: 0,
      thappy: 0,
      blink: 0,
      hopStart: -1,
      lastMove: 0,
      pupilX: 0,
      pupilY: 0,
    };

    const PUPIL_RANGE = 4;
    const TILT_RANGE = 9;
    const PARALLAX_RANGE = 10;

    // Distancia al centro del rayo, en píxeles CSS.
    const LIGHTNING_FAR = 220;
    const LIGHTNING_NEAR = 90;

    // Paleta de Rise.
    const LIGHTNING_GREEN = [32, 236, 102]; // #20EC66
    const LIGHTNING_YELLOW = [248, 191, 36]; // #F8BF24
    const LIGHTNING_RED = [239, 68, 68]; // #EF4444

    let lightningColor = "";

    const saverOn = () =>
      document.documentElement.dataset.saver === "on";

    const resetLightning = () => {
      for (const shape of lightningShapes) {
        shape.style.removeProperty("fill");
      }

      if (lightning instanceof SVGElement) {
        lightning.style.removeProperty("fill");
        lightning.style.removeProperty("color");
        lightning.style.removeProperty("filter");
      }

      lightningColor = "";
    };

    const updateLightning = (
      clientX: number,
      clientY: number,
    ) => {
      if (
        !(lightning instanceof SVGElement) ||
        lightningShapes.length === 0
      ) {
        return;
      }

      const rect = lightning.getBoundingClientRect();
      const centerX = rect.left + rect.width / 2;
      const centerY = rect.top + rect.height / 2;

      const distance = Math.hypot(
        clientX - centerX,
        clientY - centerY,
      );

      /*
       * Lejos: verde.
       * Entre 220 y 90 px: verde -> amarillo -> rojo.
       * A 90 px o menos: rojo.
       */
      const proximity = Math.max(
        0,
        Math.min(
          1,
          (LIGHTNING_FAR - distance) /
            (LIGHTNING_FAR - LIGHTNING_NEAR),
        ),
      );

      // Interpolación suave entre los tres colores.
      const from =
        proximity < 0.5
          ? LIGHTNING_GREEN
          : LIGHTNING_YELLOW;

      const to =
        proximity < 0.5
          ? LIGHTNING_YELLOW
          : LIGHTNING_RED;

      const t =
        proximity < 0.5
          ? proximity * 2
          : (proximity - 0.5) * 2;

      const rgb = from.map((channel, index) =>
        Math.round(
          channel + (to[index] - channel) * t,
        ),
      );

      const color = `rgb(${rgb.join(", ")})`;

      if (color === lightningColor) return;

      // Cambia el relleno real de las formas del SVG.
      for (const shape of lightningShapes) {
        shape.style.setProperty("fill", color);
      }

      /*
       * Resplandor de tres capas:
       * 1. Núcleo intenso.
       * 2. Halo intermedio.
       * 3. Difuminado exterior amplio.
       *
       * Todas las capas adoptan el color del rayo.
       */
      const glowCore = 5 + proximity * 5;
      const glowMid = 18 + proximity * 12;
      const glowFar = 42 + proximity * 18;

      lightning.style.setProperty(
        "filter",
        [
          `drop-shadow(0 0 ${glowCore.toFixed(1)}px ${color})`,
          `drop-shadow(0 0 ${glowMid.toFixed(1)}px ${color})`,
          `drop-shadow(0 0 ${glowFar.toFixed(1)}px color-mix(in srgb, ${color} 32%, transparent)`,
        ].join(" "),
      );

      lightningColor = color;
    };

    const scheduleBlink = () => {
      window.setTimeout(
        () => {
          state.blink = 1;
          scheduleBlink();
        },
        2600 + Math.random() * 3200,
      );
    };

    scheduleBlink();

    window.addEventListener(
      "pointermove",
      (event) => {
        if (saverOn()) return;

        state.lastMove = performance.now();

        // Las pupilas siguen el cursor.
        const box = mascot.getBoundingClientRect();
        const cx = box.left + box.width / 2;
        const cy = box.top + box.height / 2;

        const dx = event.clientX - cx;
        const dy = event.clientY - cy;
        const dist = Math.hypot(dx, dy) || 1;

        state.pupilX =
          (dx / dist) * Math.min(PUPIL_RANGE, dist / 40);

        state.pupilY =
          (dy / dist) * Math.min(PUPIL_RANGE, dist / 40);

        // Inclinación y parallax.
        const nx =
          (event.clientX / window.innerWidth - 0.5) * 2;

        const ny =
          (event.clientY / window.innerHeight - 0.5) * 2;

        state.try_ = nx * TILT_RANGE;
        state.trx = -ny * (TILT_RANGE * 0.7);

        state.tpx = -nx * PARALLAX_RANGE;
        state.tpy = -ny * (PARALLAX_RANGE * 0.6);

        // Actualiza el color y el halo del rayo.
        updateLightning(event.clientX, event.clientY);
      },
      { passive: true },
    );

    document.addEventListener("pointerleave", () => {
      state.pupilX = 0;
      state.pupilY = 0;

      state.tpx = 0;
      state.tpy = 0;
      state.trx = 0;
      state.try_ = 0;

      resetLightning();
    });

    mascot.addEventListener("pointerenter", () => {
      state.thappy = 1;
    });

    mascot.addEventListener("pointerleave", () => {
      state.thappy = 0;
    });

    mascot.addEventListener("pointerdown", () => {
      if (saverOn()) return;

      state.squash = 1;
      state.blink = 1;
      state.hopStart = performance.now();
    });

    const lerp = (
      from: number,
      to: number,
      rate: number,
    ) => from + (to - from) * rate;

    const frame = (now: number) => {
      if (saverOn()) {
        tilt.style.transform = "";

        for (const pupil of pupils) {
          pupil.style.transform = "";
        }

        resetLightning();
        requestAnimationFrame(frame);
        return;
      }

      // Suaviza el movimiento.
      state.px = lerp(state.px, state.tpx, 0.08);
      state.py = lerp(state.py, state.tpy, 0.08);

      state.rx = lerp(state.rx, state.trx, 0.08);
      state.ry = lerp(state.ry, state.try_, 0.08);

      state.happy = lerp(
        state.happy,
        state.thappy,
        0.12,
      );

      state.squash *= 0.88;

      // Pequeño salto al pulsar.
      let hop = 0;

      if (state.hopStart >= 0) {
        const t = (now - state.hopStart) / 420;

        if (t >= 1) {
          state.hopStart = -1;
        } else {
          hop = -Math.sin(t * Math.PI) * 16;
        }
      }

      // Movimiento sutil cuando no se usa el cursor.
      const idle =
        now - state.lastMove > 3000
          ? Math.sin(now / 620) * 4
          : 0;

      const sx = 1 + state.squash * 0.16;
      const sy = 1 - state.squash * 0.2;

      tilt.style.transform =
        `translate3d(${state.px.toFixed(2)}px, ${(state.py + idle + hop).toFixed(2)}px, 0) ` +
        `rotateX(${state.rx.toFixed(2)}deg) ` +
        `rotateY(${state.ry.toFixed(2)}deg) ` +
        `scale(${sx.toFixed(3)}, ${sy.toFixed(3)})`;

      for (const pupil of pupils) {
        pupil.style.transform =
          `translate(${state.pupilX.toFixed(2)}px, ${state.pupilY.toFixed(2)}px)`;
      }

      // Parpadeo.
      if (state.blink > 0) {
        state.blink = Math.max(0, state.blink - 0.12);
      }

      const lid =
        1 - Math.sin(state.blink * Math.PI) * 0.9;

      for (const eye of eyes) {
        eye.style.transform = `scaleY(${lid.toFixed(3)})`;
      }

      if (smile instanceof HTMLElement) {
        smile.style.transform =
          `scale(${(1 + state.happy * 0.25).toFixed(3)})`;
      }

      for (const cheek of cheeks) {
        cheek.style.opacity = state.happy.toFixed(3);
      }

      if (shadow instanceof HTMLElement) {
        const lift = Math.abs(idle + hop);

        shadow.style.transform =
          `scaleX(${(1 - lift / 160).toFixed(3)})`;

        shadow.style.opacity =
          (0.5 - lift / 200).toFixed(3);
      }

      requestAnimationFrame(frame);
    };

    requestAnimationFrame(frame);
  }
</script>

<style>
  .mascot {
    position: absolute;
    z-index: 2;
    left: -2.75rem;
    bottom: -1.25rem;
    width: 7rem;
    perspective: 600px;
  }

  .mascot-tilt {
    transform-style: preserve-3d;
    will-change: transform;
  }

  .mascot-sprite {
    position: relative;
    width: 8rem;
    height: 8rem;
    display: grid;
    place-items: center;
    background: transparent;
    border: none;
    border-radius: 0;
    box-shadow: none;
  }

  .mascot-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    user-select: none;
    -webkit-user-select: none;
    -webkit-user-drag: none;
    pointer-events: none;
  }

  /* Evita seleccionar o arrastrar la mascota. */
  .mascot,
  .mascot * {
    user-select: none;
    -webkit-user-select: none;
    -webkit-user-drag: none;
  }

  :global(.mascot svg),
  :global(.mascot img) {
    user-select: none;
    -webkit-user-drag: none;
  }

  html.js-anim .mascot-sprite {
    animation: bob 4.5s ease-in-out infinite;
  }

  @keyframes bob {
    0%,
    100% {
      translate: 0 0;
    }

    50% {
      translate: 0 -5px;
    }
  }

  .mascot-eye {
    position: absolute;
    top: 2rem;
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    background: var(--color-text-primary);
    border-radius: 50%;
    will-change: transform;
  }

  .mascot-eye.left {
    left: 1.5rem;
  }

  .mascot-eye.right {
    right: 1.5rem;
  }

  .pupil {
    width: 0.55rem;
    height: 0.55rem;
    background: var(--color-text-lighter);
    border-radius: 50%;
    will-change: transform;
  }

  .mascot-smile {
    position: absolute;
    left: 50%;
    bottom: 1.5rem;
    width: 2rem;
    height: 1rem;
    translate: -50% 0;
    border-bottom: 3px solid var(--color-text-primary);
    border-radius: 0 0 2rem 2rem;
    will-change: transform;
  }

  .cheek {
    position: absolute;
    bottom: 1.9rem;
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 50%;
    background: var(--color-glow-strong);
    opacity: 0;
  }

  .cheek.left {
    left: 0.9rem;
  }

  .cheek.right {
    right: 0.9rem;
  }

  .mascot-shadow {
    height: 0.8rem;
    margin: 0.45rem 1rem 0;
    background: radial-gradient(
      closest-side,
      rgb(0 0 0 / 35%),
      transparent
    );
    border-radius: 50%;
    opacity: 0.5;
  }

  @media (max-width: 900px) {
    .mascot {
      left: -0.5rem;
      bottom: -1rem;
      width: 5.5rem;
    }

    .mascot-sprite {
      width: 5.5rem;
      height: 5.5rem;
    }
  }
</style>