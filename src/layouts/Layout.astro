---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieBanner from "../components/CookieBanner.astro";
import "../styles/global.css";

import { getLang, getLocalePath, getDocPath, localeList } from "../i18n/utils";
import { htmlLang, defaultLang } from "../i18n/ui";

const lang = getLang(Astro.url);
const site = Astro.site ?? Astro.url;

interface Props {
  title?: string;
  description?: string;
  /** Doc slug without language ("privacy"). When omitted, hreflang points to the home. */
  slug?: string;
}

const { title = "Update Wise", description, slug } = Astro.props;

const canonical = new URL(Astro.url.pathname, site).toString();
const pagePath = (l: (typeof localeList)[number]) =>
  slug ? getDocPath(l, slug) : getLocalePath(l);
const pageUrl = (l: (typeof localeList)[number]) =>
  new URL(pagePath(l), site).toString();
// TODO(art): add <meta property="og:image"> once the artwork is ready (1200×630).
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0D933B" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:locale" content={htmlLang[lang].replace("-", "_")} />
    {localeList
      .filter((l) => l !== lang)
      .map((l) => (
        <meta
          property="og:locale:alternate"
          content={htmlLang[l].replace("-", "_")}
        />
      ))}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}

    {localeList.map((l) => (
      <link rel="alternate" hreflang={htmlLang[l]} href={pageUrl(l)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={pageUrl(defaultLang)} />
    <script is:inline>
      const savedTheme = localStorage.getItem("theme");
      if (savedTheme) {
        document.documentElement.dataset.theme = savedTheme;
      } else {
        const systemTheme = window.matchMedia("(prefers-color-scheme: dark)")
          .matches
          ? "dark"
          : "light";
        document.documentElement.dataset.theme = systemTheme;
      }
    </script>
    <script is:inline>
      // Saver mode for slow connections: explicit choice wins, otherwise
      // auto-enable on Save-Data or 2G-class networks.
      //
      // Network Information API types (not in TS DOM lib):
      // { saveData?: boolean, effectiveType?: string,
      //   addEventListener?: (type, listener) => void }
      const saverKey = "uw-saver";
      const readSaverPref = () => {
        try {
          return window.localStorage.getItem(saverKey);
        } catch {
          return null;
        }
      };
      const saverConnection = () => {
        const holder =
          typeof navigator === "undefined" ? null : navigator["connection"];
        return holder && typeof holder === "object" ? holder : null;
      };
      const applySaver = () => {
        const pref = readSaverPref();
        const conn = saverConnection();
        const slow =
          !!conn &&
          (conn.saveData === true ||
            conn.effectiveType === "slow-2g" ||
            conn.effectiveType === "2g");
        const on = pref === "on" || (pref !== "off" && slow);
        document.documentElement.dataset.saver = on ? "on" : "off";
      };
      applySaver();
      const liveConnection = saverConnection();
      if (
        liveConnection &&
        typeof liveConnection.addEventListener === "function"
      ) {
        liveConnection.addEventListener("change", () => {
          // Only auto-adjust when the visitor has no explicit choice.
          if (readSaverPref() === "on" || readSaverPref() === "off") return;
          applySaver();
        });
      }
    </script>
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
    <CookieBanner />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    margin-top: 4rem;

    width: 100%;
    height: 100%;
  }
</style>
