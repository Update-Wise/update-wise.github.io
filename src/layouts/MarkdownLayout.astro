---
// Header and Footer come from Layout, so they are not duplicated here.
import Layout from "./Layout.astro";
import { getLang, useTranslations } from "../i18n/utils";
import type { MarkdownHeading } from "astro";

const lang = getLang(Astro.url);
const t = useTranslations(lang);

type TocHeading = Pick<MarkdownHeading, "depth" | "slug" | "text">;

interface TocNode extends TocHeading {
  children: TocNode[];
}

interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
  updatedAt?: string;
  /** Overrides the date label (defaults to the localized "Updated"). */
  updatedLabel?: string;
  /** Renders a back link above the header (used by blog posts). */
  backHref?: string;
  backLabel?: string;
  /** Doc slug without language ("privacy"). When omitted, hreflang points to the home. */
  slug?: string;
  /** Headings from `render(entry)` — rendered as a tree menu (h2-h4). */
  headings?: TocHeading[];
}

// Also accepts legacy `frontmatter` prop from plain .md layouts.
const legacy = (Astro.props as { frontmatter?: Props }).frontmatter;
const {
  title,
  description,
  eyebrow,
  updatedAt,
  updatedLabel,
  backHref,
  backLabel,
  slug,
} = legacy ?? (Astro.props as Props);
const rawHeadings = legacy?.headings ?? (Astro.props as Props).headings ?? [];

// Skip h1: the page header already renders the title. Nest h3/h4 under h2.
const toc: TocNode[] = [];
for (const h of rawHeadings) {
  if (h.depth < 2 || h.depth > 4) continue;
  const node: TocNode = { ...h, children: [] };
  const last = toc[toc.length - 1];
  if (h.depth === 2 || !last) {
    toc.push(node);
  } else if (h.depth === 3) {
    last.children.push(node);
  } else {
    const parent = last.children[last.children.length - 1] ?? last;
    parent.children.push(node);
  }
}
---

<Layout title={title} description={description} slug={slug}>
  <main class="markdown-page">
    <div class="read-progress" data-read-progress aria-hidden="true"></div>
    {backHref && backLabel && (
      <a class="markdown-back" href={backHref}>
        ← {backLabel}
      </a>
    )}
    <header class="markdown-header">
      {eyebrow && <p class="markdown-eyebrow">{eyebrow}</p>}

      <h1>{title}</h1>

      {description && <p class="markdown-description">{description}</p>}

      {updatedAt && (
        <time datetime={updatedAt}>
          {updatedLabel ?? t("doc.updated")}: {updatedAt}
        </time>
      )}
    </header>

    <div class="markdown-body">
      {toc.length > 0 && (
        <aside class="markdown-toc" aria-label={t("doc.toc")}>
          <nav class="toc-card">
            <p class="toc-title">{t("doc.toc")}</p>
            <ul class="toc-tree">
              {toc.map((h2) => (
                <li>
                  <a href={`#${h2.slug}`} data-toc-link={h2.slug}>
                    {h2.text}
                  </a>
                  {h2.children.length > 0 && (
                    <ul>
                      {h2.children.map((h3) => (
                        <li>
                          <a href={`#${h3.slug}`} data-toc-link={h3.slug}>
                            {h3.text}
                          </a>
                          {h3.children.length > 0 && (
                            <ul>
                              {h3.children.map((h4) => (
                                <li>
                                  <a
                                    href={`#${h4.slug}`}
                                    data-toc-link={h4.slug}
                                  >
                                    {h4.text}
                                  </a>
                                </li>
                              ))}
                            </ul>
                          )}
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )}

      <article class="markdown-content">
        <slot />
      </article>
    </div>
  </main>
</Layout>

<script>
  const tocLinks = [
    ...document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"),
  ];
  if (tocLinks.length > 0 && "IntersectionObserver" in window) {
    const sections = tocLinks
      .map((a) => document.getElementById(a.dataset.tocLink ?? ""))
      .filter((el): el is HTMLElement => el instanceof HTMLElement);

    const setActive = (slug: string) => {
      for (const a of tocLinks) {
        const on = a.dataset.tocLink === slug;
        a.classList.toggle("is-active", on);
        if (on) a.setAttribute("aria-current", "true");
        else a.removeAttribute("aria-current");
      }
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) setActive(entry.target.id);
        }
      },
      { rootMargin: "-30% 0px -60% 0px" },
    );
    for (const section of sections) observer.observe(section);
  }

  // Hover permalink on headings (decorative; the TOC already navigates).
  const article = document.querySelector(".markdown-content");
  if (article) {
    const headings = article.querySelectorAll("h2[id], h3[id], h4[id]");
    for (const heading of headings) {
      const anchor = document.createElement("a");
      anchor.href = `#${heading.id}`;
      anchor.className = "heading-anchor";
      anchor.textContent = "#";
      anchor.setAttribute("aria-hidden", "true");
      anchor.tabIndex = -1;
      heading.appendChild(anchor);
    }
  }

  // Reading progress follows the scroll position (no autonomous motion).
  const progress = document.querySelector("[data-read-progress]");
  if (progress instanceof HTMLElement) {
    let ticking = false;
    const updateProgress = () => {
      ticking = false;
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const ratio = max > 0 ? Math.min(window.scrollY / max, 1) : 0;
      progress.style.transform = `scaleX(${ratio.toFixed(3)})`;
    };
    window.addEventListener(
      "scroll",
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(updateProgress);
      },
      { passive: true },
    );
    updateProgress();
  }
</script>

<style>
  .markdown-page {
    width: min(calc(100% - 2rem), 70rem);
    margin-inline: auto;
    padding: 7rem 0 6rem;
    box-sizing: border-box;
  }

  .read-progress {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 300;
    width: 100%;
    height: 3px;
    transform: scaleX(0);
    transform-origin: 0 50%;
    background: var(--gradient-brand);
  }

  .markdown-header {
    margin-bottom: 3rem;
    text-align: center;
  }

  .markdown-back {
    display: inline-block;
    margin-bottom: 1.5rem;
    color: var(--color-text-secondary);
    font-size: 0.8rem;
    text-decoration: none;
  }

  .markdown-back:hover {
    color: var(--color-primary);
  }

  .markdown-eyebrow {
    display: inline-block;
    margin: 0 0 0.75rem;
    padding: 0.3rem 0.85rem;
    color: var(--color-primary);
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    background: var(--color-glass);
    border: 1px solid var(--color-surface-outline);
    border-radius: 999px;
  }

  .markdown-header h1 {
    margin: 0;
    font-size: 2.5rem;
    font-weight: 500;
    line-height: 1.1;
  }

  .markdown-description {
    max-width: 40rem;
    margin: 1rem auto 0;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    font-weight: 300;
    line-height: 1.6;
  }

  .markdown-header time {
    display: block;
    margin-top: 1rem;
    color: var(--color-text-secondary);
    font-size: 0.75rem;
  }

  .markdown-header::after {
    content: "";
    display: block;
    width: 4rem;
    height: 3px;
    margin: 1.5rem auto 0;
    border-radius: 999px;
    background: var(--gradient-brand);
  }

  .markdown-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 16rem;
    gap: 3rem;
    align-items: start;
    width: min(100%, 70rem);
    margin-inline: auto;
  }

  .markdown-content {
    grid-column: 1;
    grid-row: 1;
    width: 100%;
    max-width: 50rem;
    min-width: 0;

    color: var(--color-text-primary);
    font-size: 0.9rem;
    font-weight: 300;
    line-height: 1.7;

    overflow-wrap: break-word;
  }

  .markdown-toc {
    grid-column: 2;
    grid-row: 1;
    min-width: 0;
  }

  .toc-card {
    position: sticky;
    top: 10rem;
    max-height: calc(100vh - 12rem);
    overflow-y: auto;
    padding: 1rem 1.1rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-surface-secondary);
    border-radius: 1rem;
  }

  .toc-title {
    margin: 0 0 0.6rem;
    color: var(--color-text-primary);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .toc-tree,
  .toc-tree ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .toc-tree ul {
    margin-left: 0.45rem;
    padding-left: 0.8rem;
    border-left: 1px solid var(--color-surface-outline);
  }

  .toc-tree li {
    margin: 0;
    padding: 0.18rem 0;
  }

  .toc-tree a {
    display: block;
    color: var(--color-text-secondary);
    font-size: 0.75rem;
    font-weight: 300;
    line-height: 1.45;
    text-decoration: none;
    border-radius: 0.35rem;
    transition: color 0.15s ease;
  }

  .toc-tree a:hover {
    color: var(--color-primary);
  }

  .toc-tree a.is-active {
    color: var(--color-primary);
    font-weight: 500;
  }

  .markdown-content :global(h2) {
    margin-top: 3rem;
    margin-bottom: 1rem;
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.2;
    scroll-margin-top: 9rem;
  }

  .markdown-content :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-size: 1.1rem;
    font-weight: 500;
    scroll-margin-top: 9rem;
  }

  .markdown-content :global(h4) {
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    font-size: 0.95rem;
    font-weight: 500;
    scroll-margin-top: 9rem;
  }

  .markdown-content :global(p) {
    margin: 0 0 1rem;
  }

  .markdown-content :global(ul),
  .markdown-content :global(ol) {
    padding-left: 1.5rem;
    margin: 1rem 0;
  }

  .markdown-content :global(li) {
    margin-bottom: 0.4rem;
  }

  .markdown-content :global(ul li::marker) {
    color: var(--color-primary);
  }

  .markdown-content :global(ol li::marker) {
    color: var(--color-primary);
    font-weight: 500;
  }

  .markdown-content :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .markdown-content :global(a:hover) {
    text-decoration-thickness: 2px;
  }

  .markdown-content :global(.heading-anchor) {
    margin-left: 0.5rem;
    color: var(--color-primary);
    font-size: 0.8em;
    text-decoration: none;
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease-out);
  }

  .markdown-content :global(h2:hover .heading-anchor),
  .markdown-content :global(h3:hover .heading-anchor),
  .markdown-content :global(h4:hover .heading-anchor) {
    opacity: 1;
  }

  .markdown-content :global(strong) {
    font-weight: 500;
  }

  .markdown-content :global(code) {
    padding: 0.15rem 0.35rem;
    background-color: var(--color-surface-secondary);
    border-radius: 0.35rem;
    font-size: 0.85em;
  }

  .markdown-content :global(pre) {
    max-width: 100%;
    overflow-x: auto;
    padding: 1rem;
    background-color: var(--color-surface-darkened);
    border-radius: 0.75rem;
    color: var(--color-text-lighter);
    font-size: 0.8rem;
  }

  .markdown-content :global(blockquote) {
    margin: 1.5rem 0;
    padding: 0.75rem 1rem;
    border-left: 3px solid var(--color-primary);
    border-radius: 0 0.5rem 0.5rem 0;
    background-color: var(--color-surface-secondary);
    color: var(--color-text-secondary);
  }

  .markdown-content :global(hr) {
    margin: 2.5rem auto;
    border: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-surface-outline),
      transparent
    );
  }

  .markdown-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 0.75rem;
    box-shadow: 0 12px 32px -12px var(--color-glow-strong);
  }

  .markdown-content :global(figure) {
    margin: 1.5rem 0;
    text-align: center;
  }

  .markdown-content :global(figcaption) {
    margin-top: 0.5rem;
    color: var(--color-text-secondary);
    font-size: 0.75rem;
  }

  .markdown-content :global(table) {
    display: block;
    width: 100%;
    margin: 1.5rem 0;
    overflow-x: auto;
    border: 1px solid var(--color-surface-secondary);
    border-radius: 0.75rem;
    border-collapse: collapse;
    font-size: 0.8rem;
  }

  .markdown-content :global(th),
  .markdown-content :global(td) {
    padding: 0.6rem 0.9rem;
    text-align: left;
    border-bottom: 1px solid var(--color-surface-secondary);
  }

  .markdown-content :global(th) {
    background-color: var(--color-surface-secondary);
    font-weight: 500;
    white-space: nowrap;
  }

  .markdown-content :global(tbody tr:nth-child(even)) {
    background-color: var(--color-surface-secondary);
  }

  .markdown-content :global(tr:last-child td) {
    border-bottom: 0;
  }

  @media (max-width: 900px) {
    .markdown-body {
      grid-template-columns: minmax(0, 1fr);
    }

    .markdown-toc {
      grid-column: 1;
      grid-row: 1;
    }

    .markdown-content {
      grid-column: 1;
      grid-row: 2;
    }

    .toc-card {
      position: static;
      max-height: 16rem;
    }
  }

  @media (max-width: 700px) {
    .markdown-page {
      width: min(calc(100% - 2rem), 50rem);
      padding-top: 5rem;
    }

    .markdown-header h1 {
      font-size: 2rem;
    }

    .markdown-content {
      font-size: 0.85rem;
    }
  }
</style>
